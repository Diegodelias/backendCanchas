# Copiar como .env y completar. No versionar .env.
# Este archivo NO debe contener credenciales reales.

NODE_ENV=development
PORT=3100
HOST=0.0.0.0

# Obligatoria: conexión a PostgreSQL.
DATABASE_URL=postgres://canchas3:canchas3@localhost:5432/canchas3

# Cookie de sesión solo por HTTPS (true/false). Vacía: true si NODE_ENV=production, false en el resto.
SESSION_COOKIE_SECURE=

# --- Mails de acceso del jugador ---
# Dirección pública del frontend: con ella se arma el link del mail (<PUBLIC_APP_URL>/acceso?token=…).
# Vacía: http://localhost:3000. Obligatoria si NODE_ENV=production.
PUBLIC_APP_URL=
# Servidor SMTP (ej. smtp://usuario:clave@smtp.proveedor.com:587). Vacía: el link se imprime en el log
# del backend y no se envía ningún mail. Obligatoria si NODE_ENV=production.
# Con docker compose, el servicio mailpit recibe los mails de prueba (ver http://localhost:8025).
SMTP_URL=
# Remitente de los mails. Vacío: Canchas3 <no-reply@canchas3.example>.
MAIL_FROM=

# --- Cámara en vivo (opcional) ---
# Sin estas variables el backend arranca igual y la ruta responde "cámara no configurada".
# Son todo o nada: si se define alguna de las cuatro primeras, hay que definirlas todas.
# Poner las credenciales reales solo en el .env local o en los secretos de la plataforma.
CAM_USER=
CAM_PASS=
CAM_HOST=
# Identificador que usa el frontend en la URL (ej. estacion-norte-c1).
LIVE_CAMERA_ID=
# Canal: 201 (H.264) es el único verificado. El 101 es HEVC y no se reproduce en el navegador.
LIVE_CAMERA_CHANNEL=201
# Espectadores simultáneos permitidos (cada uno abre su propio ffmpeg).
LIVE_MAX_VIEWERS=3
# Tiempo máximo (ms) para recibir el primer byte de video antes de responder 502.
LIVE_FIRST_BYTE_TIMEOUT_MS=20000
# Ruta de ffmpeg si no está en el PATH (ej. C:/ffmpeg/bin/ffmpeg.exe).
FFMPEG=ffmpeg
