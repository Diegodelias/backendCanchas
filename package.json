{
  "name": "canchas3-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "migrate": "node-pg-migrate up --envPath .env --migrations-dir migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "crear-admin": "tsx --env-file=.env src/cli/crear-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
